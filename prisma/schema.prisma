generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  password              String?
  googleId              String?   @unique
  avatar                String?
  gender                String?   // "Mr" or "Mrs"
  birthday              String?   // date string "YYYY-MM-DD"
  role                  String    @default("user") // "user" or "superadmin"
  emailVerified         Boolean   @default(false)
  verificationOtp       String?
  verificationOtpExpiry DateTime?
  resetToken            String?
  resetTokenExpiry      DateTime?
  stores                Store[]
  orders                Order[]   @relation("CustomerOrders")
  notifications         Notification[]
}

model Store {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  type         String     @default("STORE") // "STORE" or "WEBSITE"
  template     String     @default("modern")
  primaryColor String     @default("#3b82f6")
  settings     String     @default("{}") // JSON string
  ownerId      String
  isActive         Boolean    @default(true)
  status           String     @default("trial") // trial, active, suspended, deleted
  plan             String     @default("free") // free, starter, business, plus, enterprise
  trialEndsAt      DateTime?
  subscriptionEndsAt DateTime?
  owner            User       @relation(fields: [ownerId], references: [id])
  products     Product[]
  categories   Category[]
  banners      Banner[]
  facebookPixelId  String?
  tiktokPixelId    String?
  snapchatPixelId  String?
  googleAnalyticsId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  media        Media[]
  orders       Order[]
  visits       Visit[]
  cartAdds     CartAdd[]
  reviews      Review[]
  wishlistItems WishlistItem[]
  coupons      Coupon[]
  subscribers  NewsletterSubscriber[]
  reactivationRequests ReactivationRequest[]
  heroSection          HeroSection?
  services             Service[]
  transformations      Transformation[]
  pricingPlans         PricingPlan[]
  testimonials         Testimonial[]
  footerConfig         FooterConfig?
}

model Template {
  id          String   @id
  name        String
  description String
  preview     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  name      String
  type      String   @default("image") // image, video
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String?
  price          Float
  discount_price Float?
  images         String      @default("[]") // JSON string of image URLs
  sizes          String      @default("[]") // JSON string of available sizes
  colors         String      @default("[]") // JSON string of available colors
  category_id    String
  category       Category    @relation(fields: [category_id], references: [id])
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status         String      @default("active")
  stock_quantity Int         @default(0)
  orderItems     OrderItem[]
  reviews        Review[]
  wishlistItems  WishlistItem[]

  @@index([storeId])
  @@index([category_id])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  image       String?
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
  parentId    String?
  parent      Category? @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")
}

model Banner {
  id         String  @id @default(cuid())
  imageUrl   String
  mobileImageUrl String?
  title      String
  subtitle   String?
  buttonText String?
  buttonLink String?
  showButton Boolean @default(true)
  buttonPosition String @default("center")
  buttonShape String @default("rounded")
  buttonColor String @default("primary")
  isActive   Boolean @default(true)
  order      Int     @default(0)
  position   String  @default("top")
  targetPage String  @default("home")
  storeId    String
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  notes           String?
  totalAmount     Float
  status          String      @default("pending") // pending, paid, processing, shipped, delivered, cancelled
  paymentMethod   String?     // stripe, paymob, paypal, bank_transfer, cash, etc.
  paymentStatus   String      @default("unpaid") // unpaid, paid, refunded, failed
  transactionId   String?     // Stripe PaymentIntent ID, Paymob transaction ID, etc.
  paymentDetails  String?     // JSON string with provider-specific details (receipt URL, etc.)
  items           OrderItem[]
  userId          String?     // The customer's user ID (optional for guest checkout)
  user            User?       @relation("CustomerOrders", fields: [userId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // Price at the time of purchase
  size      String?
  color     String?
  image     String?
}

model Visit {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
}

model CartAdd {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
}

model DailyMetric {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime // Midnight UTC of the day represented
  visits    Int      @default(0)
  cartAdds  Int      @default(0)
  orders    Int      @default(0)
  revenue   Float    @default(0.0)

  @@unique([storeId, date])
  @@index([storeId])
  @@index([date])
}

model Review {
  id            String   @id @default(cuid())
  rating        Int
  comment       String?
  customerName  String
  customerEmail String?
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([storeId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([storeId])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String
  discountType  String   @default("percentage") // "percentage" or "fixed"
  discountValue Float
  minOrder      Float?
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([storeId, code])
  @@index([storeId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, email])
  @@index([storeId])
}

model ReactivationRequest {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan           String   @default("6-months") // monthly, 3-months, 6-months, annual
  planLabel      String   @default("6 Months") // Monthly, 3 Months, 6 Months, Annual
  durationDays   Int      @default(180) // 30, 90, 180, 365
  customerPhone  String   // رقم العميل اللي دفع منه
  receiptImage   String?  // صورة الإيصال (base64 data URL)
  notes          String?  // ملاحظات من العميل
  status         String   @default("pending") // pending, approved, rejected
  reviewedBy     String?  // ID السوبر ادمن
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  type      String   @default("general")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ===== Fitness Template (برعي) Models =====

model HeroSection {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  badge          String   @default("ELITE ONLINE COACHING")
  title          String   @default("Advance Like Lightning")
  subtitle       String   @default("Training and nutrition plans scientifically designed to help you reach peak performance.")
  backgroundImage String?
  runnerImage    String?
  lightningImage String?
  avatars        Json     @default("[]") // string[]
  primaryCtaText  String  @default("About Us")
  primaryCtaLink  String  @default("#about")
  secondaryCtaText String @default("Subscribe Now")
  secondaryCtaLink String @default("#pricing")
  statValue      String   @default("20")
  statSuffix     String   @default("k+")
  statLabel      String   @default("Over 20,000 people transformed")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId])
  @@index([storeId])
}

model Service {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  icon        String   @default("💪")
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, sortOrder])
}

model Transformation {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String   @default("")
  beforeImage String
  afterImage  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, sortOrder])
}

model PricingPlan {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  subtitle  String   @default("")
  price     String
  currency  String   @default("£")
  duration  String   @default("")
  popular   Boolean  @default(false)
  badge     String   @default("")
  features  Json     @default("[]") // string[]
  ctaText   String   @default("Get Started")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  role      String   @default("")
  content   String
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, sortOrder])
}

model FooterConfig {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logo        String?
  description String   @default("")
  address     String   @default("")
  email       String   @default("")
  phone       String   @default("")
  socialLinks Json     @default("[]") // [{ platform, url, icon }]
  footerLinks Json     @default("[]") // [{ label, url }]
  iosAppUrl   String?
  androidAppUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId])
  @@index([storeId])
}
